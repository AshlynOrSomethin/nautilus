diff --git a/src/meson.build b/src/meson.build
--- a/src/meson.build
+++ b/src/meson.build
@@ -1,6 +1,6 @@
 ptyxis_sources = [
   'gdkhsla.c',
-  'main.c',
+  'ptyxis-embed.c',
   'ptyxis-add-button-list-item.c',
   'ptyxis-add-button-list-model.c',
   'ptyxis-application.c',
@@ -110,9 +110,25 @@
   include_directories('../agent'),
 ]
 
-executable('ptyxis', ptyxis_sources + ptyxis_agent_ipc,
+executable('ptyxis', ['main.c'] + ptyxis_sources + ptyxis_agent_ipc,
          dependencies: ptyxis_deps,
               install: true,
                c_args: ptyxis_c_args,
   include_directories: ptyxis_include_directories,
 )
+
+ptyxis_embed_library = shared_library(
+  'ptyxis-embed',
+  ptyxis_sources + ptyxis_agent_ipc,
+  dependencies: ptyxis_deps,
+  c_args: ptyxis_c_args + ['-DPTYXIS_EMBEDDED'],
+  include_directories: ptyxis_include_directories,
+  install: true,
+)
+
+ptyxis_embed_dep = declare_dependency(
+  link_with: ptyxis_embed_library,
+  dependencies: ptyxis_deps,
+  include_directories: ptyxis_include_directories,
+  sources: ptyxis_agent_ipc[1],
+)
